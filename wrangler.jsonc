{
  "name": "nastaliq-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "./public/", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  // Needs Email Routing enabled on nastaliq.co. LEAD_TO (the Gmail that receives leads) is a secret, set in the dashboard, never in this repo.
  "send_email": [{ "name": "MAIL" }],
  "observability": { "enabled": true }
}
